{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Who is more likely, and who is less likely?",
    "subtitle": "Share with diabetes in each group (dot) compared with the average (grey tick), 2022"
  },
  "data": {
    "url": "data/characteristics.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number",
        "base": "number"
      }
    }
  },
  "width": "container",
  "height": 640,
  "transform": [
    {
      "calculate": "datum.kind == 'header' ? '​' + substring(datum.label, 1) : datum.label",
      "as": "key"
    },
    {
      "calculate": "datum.kind == 'header' ? substring(datum.label, 1) : datum.label",
      "as": "show"
    },
    {
      "calculate": "datum.value > datum.base",
      "as": "higher"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.kind == 'row'"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "key",
          "type": "ordinal",
          "sort": [
            "​Household",
            "Family with children at home",
            "Group household",
            "Family, no children at home",
            "Lives alone",
            "​Disability",
            "No disability",
            "Other disability",
            "Moderate or mild limitation",
            "Severe or profound limitation",
            "​Where born",
            "Moved here in last 10 years",
            "Born in Australia",
            "Moved here over 10 years ago",
            "​Work (people 15+)",
            "Employed full-time",
            "Employed part-time",
            "Unemployed",
            "Not in the workforce",
            "​Highest schooling or study (people 15+)",
            "Bachelor degree or above",
            "Year 12",
            "Year 10 or below"
          ],
          "axis": {
            "title": null,
            "labelLimit": 300,
            "labelFontSize": 12.5,
            "domain": false,
            "ticks": false,
            "labelExpr": "substring(datum.label,0,1) == '​' ? '' : datum.label"
          }
        },
        "x": {
          "field": "base",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              18
            ]
          },
          "axis": {
            "title": "% of people in the group with diabetes",
            "format": ".0f"
          }
        },
        "x2": {
          "field": "value"
        },
        "color": {
          "condition": {
            "test": "datum.higher",
            "value": "#b0453d"
          },
          "value": "#2d84a1"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'row'"
        }
      ],
      "mark": {
        "type": "tick",
        "color": "#6b7785",
        "thickness": 3,
        "size": 20
      },
      "encoding": {
        "y": {
          "field": "key",
          "type": "ordinal",
          "sort": [
            "​Household",
            "Family with children at home",
            "Group household",
            "Family, no children at home",
            "Lives alone",
            "​Disability",
            "No disability",
            "Other disability",
            "Moderate or mild limitation",
            "Severe or profound limitation",
            "​Where born",
            "Moved here in last 10 years",
            "Born in Australia",
            "Moved here over 10 years ago",
            "​Work (people 15+)",
            "Employed full-time",
            "Employed part-time",
            "Unemployed",
            "Not in the workforce",
            "​Highest schooling or study (people 15+)",
            "Bachelor degree or above",
            "Year 12",
            "Year 10 or below"
          ]
        },
        "x": {
          "field": "base",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'row'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "key",
          "type": "ordinal",
          "sort": [
            "​Household",
            "Family with children at home",
            "Group household",
            "Family, no children at home",
            "Lives alone",
            "​Disability",
            "No disability",
            "Other disability",
            "Moderate or mild limitation",
            "Severe or profound limitation",
            "​Where born",
            "Moved here in last 10 years",
            "Born in Australia",
            "Moved here over 10 years ago",
            "​Work (people 15+)",
            "Employed full-time",
            "Employed part-time",
            "Unemployed",
            "Not in the workforce",
            "​Highest schooling or study (people 15+)",
            "Bachelor degree or above",
            "Year 12",
            "Year 10 or below"
          ]
        },
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.higher",
            "value": "#b0453d"
          },
          "value": "#2d84a1"
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Group"
          },
          {
            "field": "value",
            "title": "% with diabetes",
            "format": ".1f"
          },
          {
            "field": "base",
            "title": "Average for this age range %",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'row' && datum.higher"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "fontWeight": 700,
        "fontSize": 12
      },
      "encoding": {
        "y": {
          "field": "key",
          "type": "ordinal",
          "sort": [
            "​Household",
            "Family with children at home",
            "Group household",
            "Family, no children at home",
            "Lives alone",
            "​Disability",
            "No disability",
            "Other disability",
            "Moderate or mild limitation",
            "Severe or profound limitation",
            "​Where born",
            "Moved here in last 10 years",
            "Born in Australia",
            "Moved here over 10 years ago",
            "​Work (people 15+)",
            "Employed full-time",
            "Employed part-time",
            "Unemployed",
            "Not in the workforce",
            "​Highest schooling or study (people 15+)",
            "Bachelor degree or above",
            "Year 12",
            "Year 10 or below"
          ]
        },
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'row' && !datum.higher"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -11,
        "fontWeight": 700,
        "fontSize": 12
      },
      "encoding": {
        "y": {
          "field": "key",
          "type": "ordinal",
          "sort": [
            "​Household",
            "Family with children at home",
            "Group household",
            "Family, no children at home",
            "Lives alone",
            "​Disability",
            "No disability",
            "Other disability",
            "Moderate or mild limitation",
            "Severe or profound limitation",
            "​Where born",
            "Moved here in last 10 years",
            "Born in Australia",
            "Moved here over 10 years ago",
            "​Work (people 15+)",
            "Employed full-time",
            "Employed part-time",
            "Unemployed",
            "Not in the workforce",
            "​Highest schooling or study (people 15+)",
            "Bachelor degree or above",
            "Year 12",
            "Year 10 or below"
          ]
        },
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'header'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontWeight": 700,
        "fontSize": 13,
        "color": "#47566a"
      },
      "encoding": {
        "y": {
          "field": "key",
          "type": "ordinal",
          "sort": [
            "​Household",
            "Family with children at home",
            "Group household",
            "Family, no children at home",
            "Lives alone",
            "​Disability",
            "No disability",
            "Other disability",
            "Moderate or mild limitation",
            "Severe or profound limitation",
            "​Where born",
            "Moved here in last 10 years",
            "Born in Australia",
            "Moved here over 10 years ago",
            "​Work (people 15+)",
            "Employed full-time",
            "Employed part-time",
            "Unemployed",
            "Not in the workforce",
            "​Highest schooling or study (people 15+)",
            "Bachelor degree or above",
            "Year 12",
            "Year 10 or below"
          ]
        },
        "x": {
          "value": 0
        },
        "text": {
          "field": "show"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "key": "Employed part-time",
            "x": 9.5,
            "t": "Age explains part of 'lives alone' and\n'not in the workforce' (many retirees)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#222935",
        "lineBreak": "\n",
        "dx": 0,
        "dy": 0
      },
      "encoding": {
        "y": {
          "field": "key",
          "type": "ordinal",
          "sort": [
            "​Household",
            "Family with children at home",
            "Group household",
            "Family, no children at home",
            "Lives alone",
            "​Disability",
            "No disability",
            "Other disability",
            "Moderate or mild limitation",
            "Severe or profound limitation",
            "​Where born",
            "Moved here in last 10 years",
            "Born in Australia",
            "Moved here over 10 years ago",
            "​Work (people 15+)",
            "Employed full-time",
            "Employed part-time",
            "Unemployed",
            "Not in the workforce",
            "​Highest schooling or study (people 15+)",
            "Bachelor degree or above",
            "Year 12",
            "Year 10 or below"
          ]
        },
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}
