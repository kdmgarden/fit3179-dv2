{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The number of people has more than doubled",
    "subtitle": "People with diabetes, millions (survey estimate)"
  },
  "data": {
    "url": "data/trend.csv"
  },
  "width": "container",
  "height": 300,
  "transform": [
    {
      "calculate": "datum.number_k / 1000",
      "as": "m"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 3,
        "cornerRadiusTopRight": 3
      },
      "encoding": {
        "x": {
          "field": "survey",
          "type": "ordinal",
          "sort": {
            "field": "year"
          },
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 11
          }
        },
        "y": {
          "field": "m",
          "type": "quantitative",
          "axis": {
            "title": "Million people",
            "tickCount": 4
          }
        },
        "color": {
          "condition": {
            "test": "datum.year == 2022",
            "value": "#2d84a1"
          },
          "value": "#75adc6"
        },
        "tooltip": [
          {
            "field": "survey",
            "title": "Survey"
          },
          {
            "field": "number_k",
            "title": "People (thousands)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -8,
        "fontWeight": 600,
        "fontSize": 12.5
      },
      "encoding": {
        "x": {
          "field": "survey",
          "type": "ordinal",
          "sort": {
            "field": "year"
          }
        },
        "y": {
          "field": "m",
          "type": "quantitative"
        },
        "text": {
          "field": "m",
          "type": "quantitative",
          "format": ".2f"
        }
      }
    }
  ]
}
