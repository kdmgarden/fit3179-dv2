{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How much does age push the raw rate up?",
    "subtitle": [
      "Raw rate minus age-adjusted rate (percentage points).",
      "Blue: older population lifts the raw rate. Red: younger (NT)."
    ]
  },
  "data": {
    "url": "data/states.csv"
  },
  "width": "container",
  "height": 400,
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 5,
        "cornerRadius": 6
      },
      "encoding": {
        "x": {
          "field": "tile_col",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "tile_row",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "gap",
          "type": "quantitative",
          "scale": {
            "scheme": "redblue",
            "domain": [
              -2,
              2
            ],
            "domainMid": 0,
            "reverse": false
          },
          "legend": {
            "title": "Raw minus adjusted",
            "orient": "bottom",
            "gradientLength": 220,
            "format": "+.1f"
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "State"
          },
          {
            "field": "crude",
            "title": "Raw rate %",
            "format": ".1f"
          },
          {
            "field": "age_std",
            "title": "Age-adjusted %",
            "format": ".1f"
          },
          {
            "field": "gap",
            "title": "Difference",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontWeight": 700,
        "fontSize": 15,
        "dy": -9
      },
      "encoding": {
        "x": {
          "field": "tile_col",
          "type": "ordinal"
        },
        "y": {
          "field": "tile_row",
          "type": "ordinal"
        },
        "text": {
          "field": "code"
        },
        "color": {
          "condition": {
            "test": "abs(datum.gap) > 1",
            "value": "white"
          },
          "value": "#222935"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "dy": 10
      },
      "encoding": {
        "x": {
          "field": "tile_col",
          "type": "ordinal"
        },
        "y": {
          "field": "tile_row",
          "type": "ordinal"
        },
        "text": {
          "field": "gap",
          "type": "quantitative",
          "format": "+.1f"
        },
        "color": {
          "condition": {
            "test": "abs(datum.gap) > 1",
            "value": "white"
          },
          "value": "#222935"
        }
      }
    }
  ]
}
