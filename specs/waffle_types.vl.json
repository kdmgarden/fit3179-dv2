{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Picture 100 Australians with diabetes",
    "subtitle": "87 have type 2, 10 have type 1 and 3 are not known",
    "anchor": "middle"
  },
  "data": {
    "url": "data/waffle.csv"
  },
  "width": 360,
  "height": 360,
  "transform": [
    {
      "calculate": "datum.idx % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.idx / 10)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "square",
    "size": 790,
    "opacity": 1
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "type",
      "type": "nominal",
      "scale": {
        "domain": [
          "Type 2",
          "Type 1",
          "Type not known"
        ],
        "range": [
          "#2d84a1",
          "#b0453d",
          "#b5bcc5"
        ]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "symbolType": "square"
      }
    },
    "tooltip": [
      {
        "field": "type",
        "title": "Type"
      }
    ]
  }
}
