{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The number of people has more than doubled",
    "subtitle": "People with diabetes, millions (survey estimate)"
  },
  "data": { "url": "data/trend.csv" },
  "width": "container",
  "height": 300,
  "transform": [
    { "calculate": "datum.number_k / 1000", "as": "m" }
  ],
  "layer": [
    {
      "mark": { "type": "bar", "cornerRadiusTopLeft": 3, "cornerRadiusTopRight": 3, "size": 32 },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": { "domain": [1999.5, 2023.5] },
          "axis": { "values": [2001, 2008, 2012, 2015, 2018, 2022], "format": "d", "title": "Year the survey ended", "grid": false }
        },
        "y": {
          "field": "m",
          "type": "quantitative",
          "axis": { "title": "Million people", "tickCount": 3, "grid": false }
        },
        "color": {
          "condition": { "test": "datum.year == 2022", "value": "#2d84a1" },
          "value": "#75adc6"
        },
        "tooltip": [
          { "field": "survey", "title": "Survey" },
          { "field": "m", "type": "quantitative", "title": "People (millions)", "format": ".2f" }
        ]
      }
    },
    {
      "mark": { "type": "text", "dy": -8, "fontWeight": 600, "fontSize": 12.5 },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" },
        "y": { "field": "m", "type": "quantitative" },
        "text": { "field": "m", "type": "quantitative", "format": ".2f" }
      }
    }
  ]
}