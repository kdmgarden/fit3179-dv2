{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Weight, waist and blood pressure track with diabetes",
    "subtitle": "Share of adults with diabetes in each group, 2022. Dashed line = all adults (6.8%)"
  },
  "data": {
    "url": "data/risk.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number"
      }
    }
  },
  "width": "container",
  "height": 560,
  "transform": [
    {
      "calculate": "0",
      "as": "zero"
    },
    {
      "calculate": "datum.kind == 'header' ? '​' + substring(datum.label, 1) : datum.label",
      "as": "key"
    },
    {
      "calculate": "datum.kind == 'header' ? substring(datum.label, 1) : datum.label",
      "as": "show"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "x": 6.8
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          5,
          4
        ],
        "color": "#1b2a3a",
        "opacity": 0.6
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'row'"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#9fbbe8"
      },
      "encoding": {
        "y": {
          "field": "key",
          "type": "ordinal",
          "sort": [
            "​Weight (BMI)",
            "Healthy weight",
            "Overweight",
            "Obese, class I",
            "Obese, class II",
            "Obese, class III",
            "​Waist measurement",
            "Lowered risk",
            "Increased risk",
            "Substantially increased risk",
            "​Blood pressure reading",
            "Normal",
            "High",
            "Very high or severe",
            "​Everyday stress",
            "Low distress",
            "High distress",
            "Very high distress"
          ],
          "axis": {
            "title": null,
            "labelLimit": 300,
            "labelFontSize": 12.5,
            "domain": false,
            "ticks": false,
            "labelExpr": "substring(datum.label,0,1) == '​' ? '' : datum.label"
          }
        },
        "x": {
          "field": "zero",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              22
            ]
          },
          "axis": {
            "title": "% of adults with diabetes",
            "format": ".0f"
          }
        },
        "x2": {
          "field": "value"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'row'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "key",
          "type": "ordinal",
          "sort": [
            "​Weight (BMI)",
            "Healthy weight",
            "Overweight",
            "Obese, class I",
            "Obese, class II",
            "Obese, class III",
            "​Waist measurement",
            "Lowered risk",
            "Increased risk",
            "Substantially increased risk",
            "​Blood pressure reading",
            "Normal",
            "High",
            "Very high or severe",
            "​Everyday stress",
            "Low distress",
            "High distress",
            "Very high distress"
          ]
        },
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.value > 6.8",
            "value": "#d9791a"
          },
          "value": "#1f5fbf"
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Group"
          },
          {
            "field": "value",
            "title": "% with diabetes",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'row'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontWeight": 700,
        "fontSize": 12
      },
      "encoding": {
        "y": {
          "field": "key",
          "type": "ordinal",
          "sort": [
            "​Weight (BMI)",
            "Healthy weight",
            "Overweight",
            "Obese, class I",
            "Obese, class II",
            "Obese, class III",
            "​Waist measurement",
            "Lowered risk",
            "Increased risk",
            "Substantially increased risk",
            "​Blood pressure reading",
            "Normal",
            "High",
            "Very high or severe",
            "​Everyday stress",
            "Low distress",
            "High distress",
            "Very high distress"
          ]
        },
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'header'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontWeight": 700,
        "fontSize": 13,
        "color": "#47566a"
      },
      "encoding": {
        "y": {
          "field": "key",
          "type": "ordinal",
          "sort": [
            "​Weight (BMI)",
            "Healthy weight",
            "Overweight",
            "Obese, class I",
            "Obese, class II",
            "Obese, class III",
            "​Waist measurement",
            "Lowered risk",
            "Increased risk",
            "Substantially increased risk",
            "​Blood pressure reading",
            "Normal",
            "High",
            "Very high or severe",
            "​Everyday stress",
            "Low distress",
            "High distress",
            "Very high distress"
          ]
        },
        "x": {
          "value": 0
        },
        "text": {
          "field": "show"
        }
      }
    }
  ]
}
