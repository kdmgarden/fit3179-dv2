{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Type 2 drives the climb after 35",
    "subtitle": "Share of people with each type of diabetes, by age group, 2022"
  },
  "data": {
    "url": "data/type_age.csv"
  },
  "width": "container",
  "height": 340,
  "params": [
    {
      "name": "legendPick",
      "select": {
        "type": "point",
        "fields": [
          "type"
        ]
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "area",
    "line": {
      "strokeWidth": 2
    },
    "interpolate": "monotone"
  },
  "encoding": {
    "x": {
      "field": "age",
      "type": "ordinal",
      "sort": [
        "0–14",
        "15–24",
        "25–34",
        "35–44",
        "45–54",
        "55–64",
        "65–74",
        "75+"
      ],
      "axis": {
        "title": "Age group (years)",
        "labelAngle": 0
      },
      "scale": {
        "padding": 0
      }
    },
    "y": {
      "field": "pct",
      "type": "quantitative",
      "stack": "zero",
      "axis": {
        "title": "% of people with diabetes (types stacked)",
        "format": ".0f"
      }
    },
    "color": {
      "field": "type",
      "type": "nominal",
      "scale": {
        "domain": [
          "Type 2",
          "Type 1"
        ],
        "range": [
          "#1f5fbf",
          "#d9791a"
        ]
      },
      "legend": {
        "title": "Click to focus",
        "orient": "top-left",
        "direction": "horizontal"
      }
    },
    "order": {
      "field": "type",
      "type": "nominal",
      "sort": "descending"
    },
    "opacity": {
      "condition": {
        "param": "legendPick",
        "value": 0.9
      },
      "value": 0.15
    },
    "tooltip": [
      {
        "field": "age",
        "title": "Age"
      },
      {
        "field": "type",
        "title": "Type"
      },
      {
        "field": "pct",
        "title": "% of people",
        "format": ".1f"
      }
    ]
  }
}
