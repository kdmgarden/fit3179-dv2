{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Type 2 drives the climb after 35",
    "subtitle": "Share of people with each type of diabetes, by age group, 2022"
  },
  "data": {
    "url": "data/type_age.csv"
  },
  "width": "container",
  "height": 340,
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "strokeWidth": 2
        },
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "age",
          "type": "ordinal",
          "sort": [
            "0–14",
            "15–24",
            "25–34",
            "35–44",
            "45–54",
            "55–64",
            "65–74",
            "75+"
          ],
          "axis": {
            "title": "Age group (years)",
            "labelAngle": 0
          },
          "scale": {
            "padding": 0
          }
        },
        "y": {
          "field": "pct",
          "type": "quantitative",
          "stack": "zero",
          "axis": {
            "title": "% of people with diabetes (types stacked)",
            "format": ".0f"
          }
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Type 2",
              "Type 1"
            ],
            "range": [
              "#2d84a1",
              "#b0453d"
            ]
          },
          "legend": {
            "title": "Click to focus",
            "orient": "top-left",
            "direction": "horizontal"
          }
        },
        "order": {
          "field": "type",
          "type": "nominal",
          "sort": "descending"
        },
        "opacity": {
          "condition": {
            "param": "legendPick",
            "value": 0.9
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "age",
            "title": "Age"
          },
          {
            "field": "type",
            "title": "Type"
          },
          {
            "field": "pct",
            "title": "% of people",
            "format": ".1f"
          }
        ]
      },
      "params": [
        {
          "name": "legendPick",
          "select": {
            "type": "point",
            "fields": [
              "type"
            ]
          },
          "bind": "legend"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "age": "15–24",
            "pct": 12.5,
            "t": "Type 2 is almost all of\nthe rise. Type 1 stays\nunder 2% at every age."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#222935",
        "lineBreak": "\n",
        "dx": 0,
        "dy": 0
      },
      "encoding": {
        "x": {
          "field": "age",
          "type": "ordinal",
          "sort": [
            "0–14",
            "15–24",
            "25–34",
            "35–44",
            "45–54",
            "55–64",
            "65–74",
            "75+"
          ]
        },
        "y": {
          "field": "pct",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}
