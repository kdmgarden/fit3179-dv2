{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "People with diabetes often live with other conditions too",
    "subtitle": ["Read across a row: people with that condition,", "and the % who also have each of the others.", "Red outline = people with diabetes."]
  },
  "data": {
    "url": "data/comorbidity.csv"
  },
  "width": "container",
  "height": 460,
  "transform": [
    {
      "filter": "datum.has != datum.also"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "also",
          "type": "nominal",
          "sort": [
            "Arthritis",
            "Asthma",
            "Back problems",
            "Cancer",
            "COPD (lung)",
            "Diabetes",
            "Heart & stroke",
            "Kidney disease",
            "Mental health",
            "Osteoporosis"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": -35,
            "title": "…the share who ALSO have",
            "labelFontSize": 12
          }
        },
        "y": {
          "field": "has",
          "type": "nominal",
          "sort": [
            "Arthritis",
            "Asthma",
            "Back problems",
            "Cancer",
            "COPD (lung)",
            "Diabetes",
            "Heart & stroke",
            "Kidney disease",
            "Mental health",
            "Osteoporosis"
          ],
          "axis": {
            "title": "Among people who have…",
            "labelFontSize": 12.5
          }
        },
        "color": {
          "field": "pct",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [
              0,
              50
            ]
          },
          "legend": {
            "title": "% who also have it",
            "orient": "right",
            "gradientLength": 200
          }
        },
        "tooltip": [
          {
            "field": "has",
            "title": "People with"
          },
          {
            "field": "also",
            "title": "Also have"
          },
          {
            "field": "pct",
            "title": "% who also have it",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "also",
          "type": "nominal",
          "sort": [
            "Arthritis",
            "Asthma",
            "Back problems",
            "Cancer",
            "COPD (lung)",
            "Diabetes",
            "Heart & stroke",
            "Kidney disease",
            "Mental health",
            "Osteoporosis"
          ]
        },
        "y": {
          "field": "has",
          "type": "nominal",
          "sort": [
            "Arthritis",
            "Asthma",
            "Back problems",
            "Cancer",
            "COPD (lung)",
            "Diabetes",
            "Heart & stroke",
            "Kidney disease",
            "Mental health",
            "Osteoporosis"
          ]
        },
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "condition": {
            "test": "datum.pct > 28",
            "value": "white"
          },
          "value": "#222935"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.has == 'Diabetes'"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#b0453d",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "field": "also",
          "type": "nominal",
          "sort": [
            "Arthritis",
            "Asthma",
            "Back problems",
            "Cancer",
            "COPD (lung)",
            "Diabetes",
            "Heart & stroke",
            "Kidney disease",
            "Mental health",
            "Osteoporosis"
          ]
        },
        "y": {
          "field": "has",
          "type": "nominal",
          "sort": [
            "Arthritis",
            "Asthma",
            "Back problems",
            "Cancer",
            "COPD (lung)",
            "Diabetes",
            "Heart & stroke",
            "Kidney disease",
            "Mental health",
            "Osteoporosis"
          ]
        }
      }
    }
  ]
}
