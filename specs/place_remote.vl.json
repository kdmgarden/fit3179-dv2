{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
     "title": {
     "text": "Rates peak in outer regional and remote areas",
     "subtitle": [
       "Adults with diabetes, 2022–24, adjusted for age (AIHW).",
       "Bar = everyone. Dots = men and women.",
       "Men: 7.1% in cities, 12.8% outer regional & remote."
     ]
   },
  "data": {
    "url": "data/aihw_place.csv"
  },
  "width": "container",
  "height": 290,
  "transform": [
    {
      "filter": "datum.kind == 'Where you live'"
    },
    {
      "calculate": "max(datum.men, datum.women)",
      "as": "top"
    },
    {
      "calculate": "'Everyone ' + format(datum.persons, '.1f') + '%'",
      "as": "lab"
    },
    {
      "fold": [
        "men",
        "women"
      ],
      "as": [
        "sexkey",
        "val"
      ]
    },
    {
      "calculate": "datum.sexkey == 'men' ? 'Men' : 'Women'",
      "as": "sex"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.sexkey == 'men'"
        }
      ],
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.5
        },
        "color": "#a6d0e6"
      },
      "encoding": {
        "y": {
          "field": "area",
          "type": "nominal",
          "sort": [
            "Major cities",
            "Inner regional",
            "Outer regional & remote"
          ],
          "axis": {
            "title": null,
            "labelLimit": 190
          }
        },
        "x": {
          "field": "persons",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              20
            ]
          },
          "axis": {
            "title": "% of adults with diabetes",
            "format": ".0f",
            "values": [
              0,
              5,
              10,
              15,
              20
            ]
          }
        },
        "tooltip": [
          {
            "field": "area",
            "title": "Area"
          },
          {
            "field": "persons",
            "title": "Everyone %",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "area",
          "type": "nominal",
          "sort": [
            "Major cities",
            "Inner regional",
            "Outer regional & remote"
          ]
        },
        "x": {
          "field": "val",
          "type": "quantitative"
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "scale": {
            "domain": [
              "Men",
              "Women"
            ],
            "range": [
              "#5b4aa6",
              "#c28a2c"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "area",
            "title": "Area"
          },
          {
            "field": "sex",
            "title": "Group"
          },
          {
            "field": "val",
            "title": "% with diabetes",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.sexkey == 'men'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -2,
        "fontWeight": 700,
        "fontSize": 12.5
      },
      "encoding": {
        "y": {
          "field": "area",
          "type": "nominal",
          "sort": [
            "Major cities",
            "Inner regional",
            "Outer regional & remote"
          ]
        },
        "x": {
          "datum": 20,
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      }
    }
  ]
}