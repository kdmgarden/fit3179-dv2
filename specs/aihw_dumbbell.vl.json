{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "A blood-test survey tells the same story",
    "subtitle": "Adults with diabetes by age, 2022–24 (AIHW). Hollow dots are less reliable estimates."
  },
  "data": {
    "url": "data/aihw_age_sex.csv"
  },
  "width": "container",
  "height": 300,
  "layer": [
    {
      "transform": [
        {
          "pivot": "sex",
          "value": "pct",
          "groupby": [
            "age"
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 4,
        "color": "#c9c3b4"
      },
      "encoding": {
        "y": {
          "field": "age",
          "type": "ordinal",
          "sort": [
            "75+",
            "65–74",
            "55–64",
            "45–54",
            "18–44"
          ],
          "axis": {
            "title": "Age group (years)"
          }
        },
        "x": {
          "field": "Men",
          "type": "quantitative"
        },
        "x2": {
          "field": "Women"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 190,
        "strokeWidth": 3,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "age",
          "type": "ordinal",
          "sort": [
            "75+",
            "65–74",
            "55–64",
            "45–54",
            "18–44"
          ]
        },
        "x": {
          "field": "pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              22
            ]
          },
          "axis": {
            "title": "% of adults with diabetes",
            "format": ".0f"
          }
        },
        "stroke": {
          "field": "sex",
          "type": "nominal",
          "scale": {
            "domain": [
              "Men",
              "Women"
            ],
            "range": [
              "#5b4aa6",
              "#d1478c"
            ]
          },
          "legend": null
        },
        "fill": {
          "condition": {
            "test": "datum.caution == 'true'",
            "value": "white"
          },
          "field": "sex",
          "type": "nominal",
          "scale": {
            "domain": [
              "Men",
              "Women"
            ],
            "range": [
              "#5b4aa6",
              "#d1478c"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "age",
            "title": "Age"
          },
          {
            "field": "sex",
            "title": "Group"
          },
          {
            "field": "pct",
            "title": "% with diabetes",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}
